rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn()  { return request.auth != null; }
    function isOwner(uid)  { return request.auth.uid == uid; }

    // أدمن التطبيق — لازم تحط نفس الـ UID هنا وفي src/config/constants.js
    // (ADMIN_UIDS). ده اللي بيسمح فعلياً بقراءة قائمة كل المستخدمين — مش
    // مجرد إخفاء زرار في الواجهة، ده الحماية الحقيقية.
    function isAdmin() {
      return isSignedIn() && request.auth.uid in [
       "VOS2uWwCxJUsmTgT4aSBqvoxPwa2"
      ];
    }

    // ─── Field-level validation helpers ──────────────────────────────────
    // كل شرط هنا بالشكل "لو الحقل مش موجود في المستند، عدّي — لو موجود،
    // لازم يبقى من النوع والمدى الصح". لازم يتكتب inline بالظبط بالشكل ده
    // (!('key' in data) || <check>) — مش عن طريق دالة wrapper بتاخد الشرط
    // كباراميتر، لأن Firestore Rules بتقيّم باراميترات الدوال قبل ما تناديها
    // (مش زي && و|| اللي بيقفوا عند أول نتيجة حاسمة) — يعني لو الحقل مش
    // موجود، أي محاولة توصل لقيمته (data.key) هتفشل بخطأ تقييم قبل حتى ما
    // تدخل الدالة، وده هيرفض أي كتابة جزئية (زي تحديث حالة سائق بس، أو
    // استعادة نسخة احتياطية) من غير أي داعي.
    //
    // الهدف مش قفل شكل المستند بالكامل (hasOnly) — ده كان هيكسر أول حقل
    // جديد يتضاف للفورم بعدين من غير ما حد يفتكر يحدّث الملف ده، وهيكسر
    // استعادة نسخ احتياطية قديمة من شكل بيانات أقدم. الهدف إن أي حقل
    // بيتكتب فعلاً يبقى من النوع الصح ومنطقي القيمة — مش نص طويل عشوائي،
    // مش رقم سالب لمبلغ، مش نوع بيانات غلط تماماً — حتى لو حد نادى الـ
    // Firestore SDK مباشرة بدل الواجهة.
    //
    // الحد الأقصى للمبالغ (1,000,000,000) نفس MAX_MONEY_VALUE في
    // src/config/constants/backup.js بالظبط — نفس الرقم من غير ما يتكرر
    // بقيمة مختلفة بالغلط.
    function isMoney(v) {
      return v is number && v >= 0 && v <= 1000000000;
    }
    // صافي الربح ممكن يكون سالب (خسارة) — نفس السقف، من غير ما نمنع
    // القيم السالبة المنطقية.
    function isSignedMoney(v) {
      return v is number && v >= -1000000000 && v <= 1000000000;
    }
    // أرقام غير مالية لكن لازلت محتاجة سقف منطقي (لترات وقود...) — نفس
    // السقف كحماية عامة ضد قيم عبثية، مش لأنه له معنى مالي مباشر.
    function isNum(v) {
      return v is number && v >= 0 && v <= 1000000000;
    }
    function isShortStr(v) {
      return v is string && v.size() <= 300;
    }
    function isLongStr(v) {
      return v is string && v.size() <= 3000;
    }
    // "YYYY-MM-DD" بالظبط — كل مكان في التطبيق (فلترة الشهر في الداشبورد،
    // التقارير، تصدير PDF) بيعتمد على prefix الشهر من الشكل ده. تاريخ بشكل
    // غلط مش بس "بيانات وسخة" — بيكسر فلترة الشهر في كل الأماكن دي بصمت.
    function isDateStr(v) {
      return v is string && v.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    // ─── Per-collection validation ───────────────────────────────────────
    // كل دالة هنا بتتأكد من الحقول الموجودة فعلاً في المستند المكتوب —
    // مش بتفرض شكل ثابت للمستند بالكامل (شوف الشرح فوق). الحقول المطلوبة
    // فعلياً وقت الإنشاء (زي amount) بتتحقق منها بشرط منفصل في الـ match
    // block نفسه (allow create)، مش هنا.

    function isValidJob(data) {
      return
        (!('acres' in data)          || (data.acres is number && data.acres > 0 && data.acres <= 1000000000)) &&
        (!('pricePerAcre' in data)   || isMoney(data.pricePerAcre)) &&
        (!('fuelUsed' in data)       || isNum(data.fuelUsed)) &&
        (!('fuelPriceAtJob' in data) || isMoney(data.fuelPriceAtJob)) &&
        (!('amountPaid' in data)     || isMoney(data.amountPaid)) &&
        (!('date' in data)           || isDateStr(data.date)) &&
        (!('client' in data)         || isShortStr(data.client)) &&
        (!('workType' in data)       || isShortStr(data.workType)) &&
        (!('notes' in data)          || isLongStr(data.notes)) &&
        (!('equipmentId' in data)    || isShortStr(data.equipmentId)) &&
        (!('driverId' in data)       || isShortStr(data.driverId));
    }

    function isValidPayment(data) {
      return
        (!('amount' in data) || (data.amount is number && data.amount > 0 && data.amount <= 1000000000)) &&
        (!('jobId' in data)  || isShortStr(data.jobId)) &&
        (!('date' in data)   || isDateStr(data.date)) &&
        (!('notes' in data)  || isLongStr(data.notes));
    }

    function isValidMaintenance(data) {
      return
        (!('cost' in data)        || isMoney(data.cost)) &&
        (!('equipmentId' in data) || isShortStr(data.equipmentId)) &&
        (!('type' in data)        || isShortStr(data.type)) &&
        (!('date' in data)        || isDateStr(data.date)) &&
        (!('notes' in data)       || isLongStr(data.notes));
    }

    function isValidEquipmentFuelEntry(data) {
      return
        (!('liters' in data)        || (data.liters is number && data.liters > 0 && data.liters <= 1000000000)) &&
        (!('pricePerLiter' in data) || (data.pricePerLiter is number && data.pricePerLiter > 0 && data.pricePerLiter <= 1000000000)) &&
        (!('equipmentId' in data)   || isShortStr(data.equipmentId)) &&
        (!('date' in data)          || isDateStr(data.date));
    }

    function isValidSalaryEntry(data) {
      return
        (!('amount' in data)   || isMoney(data.amount)) &&
        (!('type' in data)     || data.type in ['base', 'bonus', 'deduction', 'advance', 'advance_repay']) &&
        (!('driverId' in data) || isShortStr(data.driverId)) &&
        (!('reason' in data)   || isShortStr(data.reason)) &&
        (!('date' in data)     || isDateStr(data.date)) &&
        (!('notes' in data)    || isLongStr(data.notes)) &&
        (!('paid' in data)     || data.paid is bool);
    }

    function isValidCustodyTransaction(data) {
      return
        (!('amount' in data)      || (data.amount is number && data.amount > 0 && data.amount <= 1000000000)) &&
        (!('type' in data)        || data.type in ['deposit', 'expense']) &&
        (!('category' in data)    || data.category in ['equipment', 'driver', 'other']) &&
        (!('equipmentId' in data) || isShortStr(data.equipmentId)) &&
        (!('driverId' in data)    || isShortStr(data.driverId)) &&
        (!('otherLabel' in data)  || isShortStr(data.otherLabel)) &&
        (!('source' in data)      || isShortStr(data.source)) &&
        (!('date' in data)        || isDateStr(data.date)) &&
        (!('notes' in data)       || isLongStr(data.notes));
    }

    function isValidTaxDeduction(data) {
      return
        (!('amount' in data)     || (data.amount is number && data.amount > 0 && data.amount <= 1000000000)) &&
        (!('type' in data)       || data.type in ['tax', 'gov_fee', 'fine', 'other']) &&
        (!('otherLabel' in data) || isShortStr(data.otherLabel)) &&
        (!('date' in data)       || isDateStr(data.date)) &&
        (!('notes' in data)      || isLongStr(data.notes));
    }

    function isValidSupplierInvoice(data) {
      return
        (!('amount' in data)       || (data.amount is number && data.amount > 0 && data.amount <= 1000000000)) &&
        (!('supplierName' in data) || isShortStr(data.supplierName)) &&
        (!('description' in data)  || isLongStr(data.description)) &&
        (!('date' in data)         || isDateStr(data.date)) &&
        (!('notes' in data)        || isLongStr(data.notes));
    }

    function isValidSupplierPayment(data) {
      return
        (!('amount' in data)            || (data.amount is number && data.amount > 0 && data.amount <= 1000000000)) &&
        (!('supplierInvoiceId' in data) || isShortStr(data.supplierInvoiceId)) &&
        (!('date' in data)              || isDateStr(data.date)) &&
        (!('notes' in data)             || isLongStr(data.notes));
    }

    function isValidEquipment(data) {
      return
        (!('fuelRate' in data)          || isMoney(data.fuelRate)) &&
        (!('category' in data)          || data.category in ['base', 'attachment']) &&
        (!('status' in data)            || data.status in ['active', 'maintenance', 'inactive']) &&
        (!('name' in data)              || isShortStr(data.name)) &&
        (!('type' in data)              || isShortStr(data.type)) &&
        (!('driverId' in data)          || isShortStr(data.driverId)) &&
        (!('customDriverName' in data)  || isShortStr(data.customDriverName)) &&
        (!('parentEquipmentId' in data) || isShortStr(data.parentEquipmentId)) &&
        (!('customParentName' in data)  || isShortStr(data.customParentName));
    }

    function isValidDriver(data) {
      return
        (!('salary' in data)   || isMoney(data.salary)) &&
        (!('status' in data)   || data.status in ['active', 'inactive']) &&
        (!('role' in data)     || data.role in ['driver', 'staff']) &&
        (!('name' in data)     || isShortStr(data.name)) &&
        (!('phone' in data)    || isShortStr(data.phone)) &&
        (!('position' in data) || isShortStr(data.position));
    }

    // جهات اتصال العملاء والموردين — اسم + نوع + رقم تليفون بس، مفيش أي
    // حقل مالي هنا خالص. مفيش collection اسمها clients/suppliers أصلاً في
    // المشروع (شوف الملحوظة تحت "الوصول للضيوف" فوق)، فده مكان منفصل
    // بيربط رقم التليفون بالاسم + النوع، من غير أي تأثير على jobs أو
    // supplierInvoices أو أي حساب.
    function isValidContact(data) {
      return
        (!('name' in data)  || isShortStr(data.name)) &&
        (!('type' in data)  || data.type in ['client', 'supplier']) &&
        (!('phone' in data) || isShortStr(data.phone));
    }

    function isValidAttendance(data) {
      return
        (!('status' in data)   || data.status in ['present', 'absent', 'late', 'half']) &&
        (!('date' in data)     || isDateStr(data.date)) &&
        (!('driverId' in data) || isShortStr(data.driverId)) &&
        (!('notes' in data)    || isLongStr(data.notes));
    }

    // legacy — لسه موجودة بس عشان عملية الترحيل التلقائي لنظام الرواتب
    // الجديد (شوف driverCostService.js وDataContext.jsx)، مش بتتضاف لها
    // بيانات جديدة من أي فورم. فحص خفيف بس عشان مايتكسرش أثناء الترحيل.
    function isValidDriverCost(data) {
      return (!('amount' in data) || isMoney(data.amount));
    }

    function isValidSettings(data) {
      return (!('fuelPrice' in data) || isMoney(data.fuelPrice));
    }

    // تجريبي، write-only، مفيش حاجة في التطبيق بتقراه لسه (شوف
    // dashboardSummaryService.js) — بنتأكد من نوع القيم المالية زيها زي
    // أي حقل مالي تاني طالما بيتكتب فعلاً.
    function isValidDashboardSummary(data) {
      return
        (!('totalRevenue' in data)         || isMoney(data.totalRevenue)) &&
        (!('totalFuelCost' in data)        || isMoney(data.totalFuelCost)) &&
        (!('totalPaid' in data)            || isMoney(data.totalPaid)) &&
        (!('totalRemaining' in data)       || isMoney(data.totalRemaining)) &&
        (!('totalMaintCost' in data)       || isMoney(data.totalMaintCost)) &&
        (!('totalSalariesPaid' in data)    || isMoney(data.totalSalariesPaid)) &&
        (!('totalTaxDeductions' in data)   || isMoney(data.totalTaxDeductions)) &&
        (!('totalSupplierPaidOut' in data) || isMoney(data.totalSupplierPaidOut)) &&
        (!('netProfit' in data)            || isSignedMoney(data.netProfit));
    }

    // ─── الوصول للضيوف (Guest Access) — قراءة فقط ────────────────────────
    // ميزة "كود ضيف مؤقت": صاحب الحساب بيولّد كود بيدّيه لحد تاني (محاسب/
    // شريك/مورد) وصول read-only لبيانات حسابه هو، بصلاحية وتوقيت بيحددهم
    // هو. هوية الضيف = Firebase Anonymous Auth (مفيش أي مستخدم/باسورد
    // جديد ولا Cloud Function). قرارين مهمين اتاخدوا عمدًا (بالاتفاق) بعد
    // مراجعة حدود Firestore Rules الفعلية — موثقين هنا عشان محدش يحاول
    // "يصلحهم" بعدين على أساس إنهم قصور:
    //
    // 1) سويتش "إظهار البيانات المالية" لكل قسم — مبني على أساس القسم
    //    كامل، مش على مستوى الحقل جوه المستند. Firestore Rules بتسمح
    //    بمستند كامل أو تمنعه بالكامل وقت القراءة، مفيش إخفاء حقل بعينه
    //    (زي pricePerAcre) من جوه مستند مسموح أصلاً (زي jobs) — ده قيد
    //    حقيقي في المنتج نفسه مش في القواعد. يعني عمليًا: لو "البيانات
    //    المالية" مقفولة لقسم معيّن، القسم ده بيتخفى بالكامل عن الضيف
    //    (زي enabled=false بالظبط)، مش إنه يظهر بدون أرقام.
    //
    // 2) اختيار "عملاء بعينهم" — مفيش collection اسمها clients أصلاً في
    //    المشروع (useClients.js بيجمّعهم من حقل client جوه مستندات jobs).
    //    الفلترة دي بتتطبق على قسم jobs بس (حقل client في كل مستند)، ومش
    //    بتمتد لأي قسم تاني (زي payments).
    //
    // ⚠️ ملحوظة لازم تتاخد بعين الاعتبار وقت بناء واجهة الضيف (Phase 2):
    // فلترة jobs بحقل client معتمدة على resource.data.client، وFirestore
    // بيرفض أي query list/onSnapshot لو مفيهاش where('client','in',
    // allowedClients) مطابق تمامًا (Firestore بيتأكد إن الـquery نفسها
    // "مثبتة" هترجع بس مستندات تعدي القاعدة، مش إنه بيفحص كل نتيجة لوحدها
    // بعد الجلب) — يعني query عادي من غير الشرط ده هيفشل بالكامل لو فيه
    // allowedClients محدد، مش هيرجع نتايج جزئية.
    //
    // الوقت: فترة الصلاحية العامة (validFrom/validUntil) timestamp عادي.
    // ساعات اليوم الاختيارية (dailyStartMinute/dailyEndMinute) بتتخزن
    // كدقايق من نص الليل بتوقيت UTC — التحويل من توقيت الشركة المحلي
    // بيحصل في الواجهة وقت إنشاء/تعديل الكود (Phase 2/3)، مش هنا، عشان
    // القاعدة تفضل بسيطة ومعتمدة بالكامل على request.time (وقت السيرفر).
    // النافذة دي مش بتدعم عبور نص الليل (زي 10 بليل لـ2 الصبح) — start
    // لازم يكون أصغر من end وإلا تتحسب Invalid وترفض القراءة كلها.

    function isAnonymousGuest() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function hasGuestSession() {
      return isAnonymousGuest() &&
        exists(/databases/$(database)/documents/guestSessions/$(request.auth.uid));
    }

    function guestSessionData() {
      return get(/databases/$(database)/documents/guestSessions/$(request.auth.uid)).data;
    }

    function hasGuestAccessDoc(ownerUid, code) {
      return exists(/databases/$(database)/documents/users/$(ownerUid)/guestAccess/$(code));
    }

    function guestAccessData(ownerUid, code) {
      return get(/databases/$(database)/documents/users/$(ownerUid)/guestAccess/$(code)).data;
    }

    function withinGeneralPeriod(access) {
      return request.time >= access.validFrom && request.time <= access.validUntil;
    }

    // لو مفيش ساعات يوم محددة (الحقلين مش موجودين)، الفترة العامة كفاية.
    // لو حقل واحد بس موجود (شكل غير متسق)، بنرفض بدل ما نفترض نية المالك
    // (fail-closed) — الكتابة الصحيحة (isValidNewGuestAccess) بتمنع الحالة
    // دي أصلًا فمن المفروض متوصلش هنا في الاستخدام العادي.
    function withinDailyWindow(access) {
      return
        (!('dailyStartMinute' in access) && !('dailyEndMinute' in access)) ||
        (
          ('dailyStartMinute' in access) && ('dailyEndMinute' in access) &&
          access.dailyStartMinute < access.dailyEndMinute &&
          (request.time.hours() * 60 + request.time.minutes()) >= access.dailyStartMinute &&
          (request.time.hours() * 60 + request.time.minutes()) < access.dailyEndMinute
        );
    }

    function sectionOpen(access, section) {
      return section in access.sections &&
        access.sections[section].enabled == true &&
        access.sections[section].financial == true;
    }

    // شرط "جلسة ضيف صالحة دلوقتي" — من غير فحص قسم معيّن. مستخدم في
    // guestCanRead تحت، وكمان في users/{uid} (allow get) عشان الضيف يقدر
    // يقرا اسم/إيميل المالك بس (لعرض بانر "انت بتشوف بيانات [الشركة]") —
    // مفيش أي بيانات مالية في المستند ده، مجرد بروفايل. الترتيب هنا
    // مقصود: كل شرط بيتأكد إن اللي قبله صح أولًا (short-circuit &&) قبل ما
    // يحاول يقرا حقل ممكن يبقى مش موجود.
    function guestSessionValid(ownerUid) {
      return hasGuestSession() &&
        guestSessionData().ownerUid == ownerUid &&
        hasGuestAccessDoc(ownerUid, guestSessionData().code) &&
        guestAccessData(ownerUid, guestSessionData().code).redeemedByUid == request.auth.uid &&
        guestAccessData(ownerUid, guestSessionData().code).cancelled != true &&
        withinGeneralPeriod(guestAccessData(ownerUid, guestSessionData().code)) &&
        withinDailyWindow(guestAccessData(ownerUid, guestSessionData().code));
    }

    // نفس guestSessionValid + شرط القسم المحدد مفعّل وبياناته المالية ظاهرة.
    function guestCanRead(ownerUid, section) {
      return guestSessionValid(ownerUid) &&
        sectionOpen(guestAccessData(ownerUid, guestSessionData().code), section);
    }

    // نفس شرط guestCanRead('jobs') بالظبط + فلترة العميل لو المالك حدد
    // عملاء بعينهم (allowedClients). لو الحقل مش موجود أو null، كل
    // العملاء مسموحين.
    function guestCanReadJob(ownerUid, jobData) {
      return guestCanRead(ownerUid, 'jobs') &&
        (
          !('allowedClients' in guestAccessData(ownerUid, guestSessionData().code)) ||
          guestAccessData(ownerUid, guestSessionData().code).allowedClients == null ||
          jobData.client in guestAccessData(ownerUid, guestSessionData().code).allowedClients
        );
    }

    // فحص كتابة guestAccess وقت الإنشاء — المالك بس، ومستند نظيف من الأول
    // (مفيش استخدام مسبق).
    function isValidNewGuestAccess(data) {
      return
        data.name is string && data.name.size() <= 200 &&
        data.validFrom is timestamp &&
        data.validUntil is timestamp &&
        data.validUntil > data.validFrom &&
        (!('dailyStartMinute' in data) || (data.dailyStartMinute is number && data.dailyStartMinute >= 0 && data.dailyStartMinute < 1440)) &&
        (!('dailyEndMinute' in data)   || (data.dailyEndMinute   is number && data.dailyEndMinute   > 0 && data.dailyEndMinute   <= 1440)) &&
        (('dailyStartMinute' in data) == ('dailyEndMinute' in data)) &&
        (!('allowedClients' in data) || data.allowedClients == null || (data.allowedClients is list && data.allowedClients.size() <= 500)) &&
        data.sections is map &&
        data.cancelled == false &&
        data.redeemedByUid == null;
    }

    // فحص تعديل guestAccess من صاحب الحساب (تمديد/تعديل صلاحيات/إلغاء) —
    // ممنوع يلمس redeemedByUid/redeemedAt نهائيًا (دول بيتغيروا بس من جوه
    // ترانزاكشن استخدام الكود نفسها، شوف isValidGuestRedeem تحت).
    //
    // ⚠️ إصلاح (Phase 3): قبل كده كانت `after.redeemedAt == before.redeemedAt`
    // مباشرة — بما إن redeemedAt مش بيتحط أصلاً على المستند إلا وقت
    // الاستخدام (isValidNewGuestAccess مبتطلبوش)، أي تعديل من المالك (إلغاء/
    // تمديد) على كود لسه ماتستخدمش كان هيحاول يقرا حقل مش موجود في
    // before/after مع بعض، وده بيفشل تقييم القاعدة كلها (permission-denied)
    // — يعني إلغاء/تمديد كود لسه ماتستخدمش (أكتر سيناريو متوقع في Phase 3)
    // كان هيفشل دايمًا. اتصلح بنفس نمط الفحص بـ'in' المستخدم فوق لـ
    // dailyStartMinute/dailyEndMinute: نتأكد الحقل موجود في الاتنين أو مش
    // موجود في الاتنين، ونقارن القيمة بس لو موجود أصلاً.
    function isValidOwnerGuestAccessUpdate(before, after) {
      return
        after.validFrom is timestamp &&
        after.validUntil is timestamp &&
        after.validUntil > after.validFrom &&
        (!('dailyStartMinute' in after) || (after.dailyStartMinute is number && after.dailyStartMinute >= 0 && after.dailyStartMinute < 1440)) &&
        (!('dailyEndMinute' in after)   || (after.dailyEndMinute   is number && after.dailyEndMinute   > 0 && after.dailyEndMinute   <= 1440)) &&
        after.sections is map &&
        after.redeemedByUid == before.redeemedByUid &&
        (('redeemedAt' in before) == ('redeemedAt' in after)) &&
        (!('redeemedAt' in before) || after.redeemedAt == before.redeemedAt);
    }

    // فحص "استخدام" الكود — بيحصل من الضيف نفسه (Anonymous) جوه الترانزاكشن
    // الموصوفة في guestSessions تحت. بيغيّر بس redeemedByUid/redeemedAt، ومن
    // null لقيمة، ومرة واحدة بس (before.redeemedByUid لازم يبقى null)،
    // والكود لازم يكون لسه صالح زمنيًا ومش ملغي وقت الاستخدام.
    function isValidGuestRedeem(before, after) {
      return
        before.redeemedByUid == null &&
        after.redeemedByUid == request.auth.uid &&
        before.cancelled != true &&
        request.time >= before.validFrom &&
        request.time <= before.validUntil &&
        after.diff(before).affectedKeys().hasOnly(['redeemedByUid', 'redeemedAt']);
    }

    // كل بيانات الشركة (معدات، شغل، سائقين، صيانة، مدفوعات، رواتب،
    // حضور، عهدة، إعدادات...) بقت جوه users/{uid}/... بدل collections
    // منفصلة على المستوى الأعلى فيها حقل userId. الفايدة: مفيش أي حاجة
    // ممكن تُقرأ أو تتكتب من غير ما تكون جوه مسار المستخدم نفسه أصلاً —
    // العزل بقى في بنية المسار مش في شرط بيتكرر يدوي في كل collection.
    match /users/{uid} {
      // || guestSessionValid(uid) اتضافت (Phase 2) عشان واجهة الضيف تقدر
      // تعرض اسم/إيميل المالك في بانر "انت بتشوف بيانات [الشركة]" —
      // بروفايل بس، مفيش بيانات مالية في المستند ده. القراءة دي بترفض
      // تلقائيًا لو الكود منتهي/ملغي (guestSessionValid بتتحقق من الوقت
      // والإلغاء)، عكس get() الخاص بمستند guestAccess نفسه اللي بيفضل
      // مقروء حتى بعد الانتهاء (عشان واجهة الضيف تقدر تعرض "انتهت صلاحية
      // الكود" بدل رفض عام).
      allow get:             if isSignedIn() && (isOwner(uid) || isAdmin()) || guestSessionValid(uid);
      allow list:             if isSignedIn() && isAdmin();
      allow create, update:  if isSignedIn() && isOwner(uid);
      // كانت if false (منع كامل) — اتغيّرت عشان مسار "حذف الحساب نهائيًا"
      // (audit finding F-006 / AuthContext.jsx → deleteAccount) يقدر يمسح
      // آخر أثر لحساب المستخدم فعليًا، مش بس بياناته الفرعية. القرار اتاخد
      // بوعي إن ده معناه الأدمن مش هيلاقي أي سجل تاريخي (إيميل/اسم/تاريخ
      // إنشاء) عن حساب اتحذف بالطريقة دي بعد كده — لو احتجتوا سجل تدقيق
      // يفضل حتى بعد الحذف مستقبلاً (audit log)، ده قرار منتج منفصل يحتاج
      // مراجعة تانية.
      allow delete:           if isSignedIn() && isOwner(uid);

      // القراءة لسه عامة على أي subcollection جديدة تتضاف تحت مستخدم من
      // غير ما نرجع نعدّل الملف ده تاني — العزل (مين يشوف بيانات مين) لسه
      // معتمد بالكامل على المسار زي ما هو، ومحتاجش فحص حقول لأنها قراءة.
      //
      // الكتابة اتشالت من هنا ومقسّمة تحت كل subcollection تحت — كانت
      // قاعدة واحدة عامة (allow read, write) بتسمح بأي حقل بأي قيمة طالما
      // صاحب الحساب هو اللي بيكتب؛ دلوقتي كل نوع بيانات له فحص لصحة حقوله
      // المالية (مبلغ سالب، نوع بيانات غلط، نص طويل جداً...) بدل ما يتسحب
      // كامل على "هو صاحب الحساب" بس.
      //
      // audit finding F-003 (Phase 5): `|| isAdmin()` اتضافت هنا (كانت
      // owner بس). قبل كده الأدمن ما كانش يقدر يقرا محتوى أي subcollection
      // بتاعة أي شركة (jobs/payments/salaryEntries...) — بس بروفايلها
      // الأساسي (users/{uid} نفسه) وmetadata الباك أب (backups/{userId}).
      // ده كان بيمنع تقرير فحص تكامل البيانات المجمّع (dataIntegrityReport)
      // من الأدمن يشوف أي حاجة فعلياً. نفس نمط isOwner(uid) || isAdmin()
      // المستخدم بالفعل فوق في get() على users/{uid} وفي backups/{userId}
      // — قراءة بس، ومقصورة على الأدمن (isAdmin() بتتأكد من UID محدد سلفاً
      // في constants). الاختبار المقابل في scripts/testFirestoreRules.js
      // (مجموعة admin-vs-user) اتحدّث من assertFails لـ assertSucceeds.
      match /{document=**} {
        allow read: if isSignedIn() && (isOwner(uid) || isAdmin());
      }

      // مستندات أكواد الوصول للضيوف بتاعة الحساب ده. القراءة عن طريق
      // get() المباشر بس — مفيش list يسمح بتعداد كل الأكواد لغير صاحب
      // الحساب/الأدمن (وهم أصلاً معاهم get+list كامل من match
      // /{document=**} فوق، مفيش داعي نكررهم هنا).
      match /guestAccess/{code} {
        allow get: if isAnonymousGuest() && hasGuestSession() &&
          guestSessionData().ownerUid == uid && guestSessionData().code == code;

        allow create: if isSignedIn() && isOwner(uid) && isValidNewGuestAccess(request.resource.data);

        allow update: if
          (isSignedIn() && isOwner(uid) && isValidOwnerGuestAccessUpdate(resource.data, request.resource.data)) ||
          (isAnonymousGuest() && isValidGuestRedeem(resource.data, request.resource.data));

        allow delete: if isSignedIn() && isOwner(uid);
      }

      match /equipment/{id} {
        allow read:            if (isSignedIn() && (isOwner(uid) || isAdmin())) || guestCanRead(uid, 'equipment');
        allow create, update: if isSignedIn() && isOwner(uid) && isValidEquipment(request.resource.data);
        allow delete:          if isSignedIn() && isOwner(uid);
      }

      match /jobs/{id} {
        allow read:   if (isSignedIn() && (isOwner(uid) || isAdmin())) || guestCanReadJob(uid, resource.data);
        allow create: if isSignedIn() && isOwner(uid) && 'acres' in request.resource.data && isValidJob(request.resource.data);
        allow update: if isSignedIn() && isOwner(uid) && isValidJob(request.resource.data);
        allow delete: if isSignedIn() && isOwner(uid);
      }

      match /drivers/{id} {
        allow read:            if (isSignedIn() && (isOwner(uid) || isAdmin())) || guestCanRead(uid, 'drivers');
        allow create, update: if isSignedIn() && isOwner(uid) && isValidDriver(request.resource.data);
        allow delete:          if isSignedIn() && isOwner(uid);
      }

      match /maintenance/{id} {
        allow read:   if (isSignedIn() && (isOwner(uid) || isAdmin())) || guestCanRead(uid, 'maintenance');
        allow create: if isSignedIn() && isOwner(uid) && 'cost' in request.resource.data && isValidMaintenance(request.resource.data);
        allow update: if isSignedIn() && isOwner(uid) && isValidMaintenance(request.resource.data);
        allow delete: if isSignedIn() && isOwner(uid);
      }

      match /equipmentFuelEntries/{id} {
        allow read:   if (isSignedIn() && (isOwner(uid) || isAdmin())) || guestCanRead(uid, 'equipment');
        allow create: if isSignedIn() && isOwner(uid) &&
          'liters' in request.resource.data &&
          'pricePerLiter' in request.resource.data &&
          'equipmentId' in request.resource.data &&
          'date' in request.resource.data &&
          isValidEquipmentFuelEntry(request.resource.data);
        allow update: if isSignedIn() && isOwner(uid) && isValidEquipmentFuelEntry(request.resource.data);
        allow delete: if isSignedIn() && isOwner(uid);
      }

      match /payments/{id} {
        allow read:   if (isSignedIn() && (isOwner(uid) || isAdmin())) || guestCanRead(uid, 'jobs');
        allow create: if isSignedIn() && isOwner(uid) && 'amount' in request.resource.data && isValidPayment(request.resource.data);
        allow update: if isSignedIn() && isOwner(uid) && isValidPayment(request.resource.data);
        allow delete: if isSignedIn() && isOwner(uid);
      }

      match /supplierInvoices/{id} {
        allow read:   if (isSignedIn() && (isOwner(uid) || isAdmin())) || guestCanRead(uid, 'suppliers');
        allow create: if isSignedIn() && isOwner(uid) && 'amount' in request.resource.data && isValidSupplierInvoice(request.resource.data);
        allow update: if isSignedIn() && isOwner(uid) && isValidSupplierInvoice(request.resource.data);
        allow delete: if isSignedIn() && isOwner(uid);
      }

      match /supplierPayments/{id} {
        allow read:   if (isSignedIn() && (isOwner(uid) || isAdmin())) || guestCanRead(uid, 'suppliers');
        allow create: if isSignedIn() && isOwner(uid) && 'amount' in request.resource.data && isValidSupplierPayment(request.resource.data);
        allow update: if isSignedIn() && isOwner(uid) && isValidSupplierPayment(request.resource.data);
        allow delete: if isSignedIn() && isOwner(uid);
      }

      match /salaryEntries/{id} {
        allow read:   if (isSignedIn() && (isOwner(uid) || isAdmin())) || guestCanRead(uid, 'drivers');
        allow create: if isSignedIn() && isOwner(uid) && 'amount' in request.resource.data && isValidSalaryEntry(request.resource.data);
        allow update: if isSignedIn() && isOwner(uid) && isValidSalaryEntry(request.resource.data);
        allow delete: if isSignedIn() && isOwner(uid);
      }

      match /custodyTransactions/{id} {
        allow read:   if (isSignedIn() && (isOwner(uid) || isAdmin())) || guestCanRead(uid, 'custody');
        allow create: if isSignedIn() && isOwner(uid) && 'amount' in request.resource.data && isValidCustodyTransaction(request.resource.data);
        allow update: if isSignedIn() && isOwner(uid) && isValidCustodyTransaction(request.resource.data);
        allow delete: if isSignedIn() && isOwner(uid);
      }

      match /taxDeductions/{id} {
        allow read:   if (isSignedIn() && (isOwner(uid) || isAdmin())) || guestCanRead(uid, 'taxDeductions');
        allow create: if isSignedIn() && isOwner(uid) && 'amount' in request.resource.data && isValidTaxDeduction(request.resource.data);
        allow update: if isSignedIn() && isOwner(uid) && isValidTaxDeduction(request.resource.data);
        allow delete: if isSignedIn() && isOwner(uid);
      }

      match /attendance/{id} {
        allow read:            if (isSignedIn() && (isOwner(uid) || isAdmin())) || guestCanRead(uid, 'drivers');
        allow create, update: if isSignedIn() && isOwner(uid) && isValidAttendance(request.resource.data);
        allow delete:          if isSignedIn() && isOwner(uid);
      }

      // جهات اتصال العملاء والموردين (أرقام تليفونات بس) — القراءة مغطاة
      // تلقائيًا بالـ match /{document=**} فوق زي أي subcollection جديدة،
      // فمحتاجين هنا نص الكتابة بس (زي باقي الـcollections بالظبط).
      match /contacts/{id} {
        allow create, update: if isSignedIn() && isOwner(uid) && isValidContact(request.resource.data);
        allow delete:          if isSignedIn() && isOwner(uid);
      }

      // legacy — لسه موجودة بس عشان عملية الترحيل التلقائي لنظام الرواتب
      // الجديد (شوف driverCostService.js وDataContext.jsx)، مش بتتضاف لها
      // بيانات جديدة من أي فورم.
      match /driverCosts/{id} {
        allow create, update: if isSignedIn() && isOwner(uid) && isValidDriverCost(request.resource.data);
        allow delete:          if isSignedIn() && isOwner(uid);
      }

      match /meta/settings {
        allow create, update: if isSignedIn() && isOwner(uid) && isValidSettings(request.resource.data);
        allow delete:          if isSignedIn() && isOwner(uid);
      }

      match /summary/dashboard {
        allow create, update: if isSignedIn() && isOwner(uid) && isValidDashboardSummary(request.resource.data);
        allow delete:          if isSignedIn() && isOwner(uid);
      }
    }

    // ربط uid الضيف المجهول (Anonymous Auth) بحساب المالك اللي هيشوف
    // بياناته — بيتعمل مرة واحدة بس وقت أول استخدام لكود (create بس،
    // مفيش update خالص). doc id = uid بتاع الضيف نفسه.
    match /guestSessions/{guestUid} {
      allow get:  if isSignedIn() && (request.auth.uid == guestUid || isAdmin());
      allow list: if isSignedIn() && isAdmin();

      // الترانزاكشن اللي بتستخدم الكود بتعمل create هنا + update على
      // guestAccess بتاعة نفس الكود مع بعض. الشروط هنا بتتأكد إن الكود
      // (اللي هيتحدّث في نفس الترانزاكشن) لسه صالح ومستخدمش قبل كده — نفس
      // الفحص موجود تاني في isValidGuestRedeem لأن الاتنين لازم ينجحوا مع
      // بعض عشان الترانزاكشن كلها تعدي.
      allow create: if isAnonymousGuest() && request.auth.uid == guestUid &&
        request.resource.data.keys().hasOnly(['ownerUid', 'code', 'createdAt']) &&
        request.resource.data.ownerUid is string &&
        request.resource.data.code is string &&
        get(/databases/$(database)/documents/users/$(request.resource.data.ownerUid)/guestAccess/$(request.resource.data.code)).data.redeemedByUid == null &&
        get(/databases/$(database)/documents/users/$(request.resource.data.ownerUid)/guestAccess/$(request.resource.data.code)).data.cancelled != true &&
        request.time >= get(/databases/$(database)/documents/users/$(request.resource.data.ownerUid)/guestAccess/$(request.resource.data.code)).data.validFrom &&
        request.time <= get(/databases/$(database)/documents/users/$(request.resource.data.ownerUid)/guestAccess/$(request.resource.data.code)).data.validUntil;

      // ثابتة بعد الإنشاء — مفيش أي تعديل عليها من أي حد.
      allow update: if false;
      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Automatic + manual data backups. Doc id under /backups is the userId
    // itself (metadata: lastBackupAt), snapshots live in a subcollection.
    // فضلت على المستوى الأعلى (مش جوه users/{uid}) عشان الأدمن يقدر يقرا
    // الـ meta بتاعت كل الشركات دفعة واحدة (شاشة متابعة) من غير collection
    // group query — القراءة دي metadata بس (تاريخ آخر باك أب)، مش محتوى
    // النسخ نفسه، اللي لسه مقفول على صاحبه بس.
    match /backups/{userId} {
      allow read:  if isSignedIn() && (isOwner(userId) || isAdmin());
      allow write: if isSignedIn() && isOwner(userId);

      match /snapshots/{snapshotId} {
        allow read, write: if isSignedIn() && isOwner(userId);

        // النسخ الاحتياطية الكبيرة (قربت من حد الـ 1MB لكل مستند في
        // Firestore) بتتقسّم على مستندات "chunks" فرعية (backupService.js
        // → createBackup/getSnapshot). بدون القاعدة دي، القاعدة الأعلى
        // (بتاعة /snapshots/{snapshotId} نفسه) ما كانت تغطيش الـ
        // subcollection دي خالص — Firestore rules ما بتنزلش تلقائيًا على
        // subcollections من غير match صريح — يعني كل نسخة احتياطية كبيرة
        // كانت هتفشل بـ permission-denied وقت الكتابة أو القراءة.
        match /chunks/{chunkId} {
          allow read, write: if isSignedIn() && isOwner(userId);
        }
      }
    }

    // سجل أخطاء التطبيق — أي مستخدم مسجّل دخول يقدر يكتب خطأ حصل عنده
    // (write-only بالنسبة له، مش بيقرا القائمة أبداً)، والأدمن بس اللي
    // يقدر يقرا/يعدّل (يعلّم كـ "متحلّة")/يمسح.
    match /errorLogs/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // تنبيهات بيبعتها الأدمن للمستخدمين — إما لكل الشركات (targetUserId
    // == null) أو لشركة واحدة بعينها (targetUserId == uid بتاعها).
    // القراءة مسموحة للمستخدم لو الرسالة موجهالكل الناس أو موجهاله هو
    // بالتحديد — الشرط ده بيتأكد منه Firestore نفسه لكل مستند على حدة،
    // مش بس بيثق في فلتر الكويري اللي الفرونت باعته.
    match /adminMessages/{id} {
      allow read: if isSignedIn() &&
        (resource.data.targetUserId == null ||
         resource.data.targetUserId == request.auth.uid ||
         isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ─── نظام الباقات والاشتراكات (Phase 1 — دفع يدوي مؤقت) ─────────────
    // entitlements و subscriptions مقصودين يبقوا top-level (مش جوه
    // users/{uid}) عشان الأدمن يقدر يقرا كل الشركات دفعة واحدة (allow
    // list)، ونفس الوقت الكتابة عليهم مقفولة على الأدمن بس — التطبيق
    // بيقرا صلاحياته من هنا بس، ما بيقدرش يغيّر باقته أو تاريخ انتهاءها
    // بنفسه من الفرونت إند. ده هو اللي بيمنع التلاعب بالسعر/حالة
    // الاشتراك من جهة العميل (راجع قسم "أمان Billing" في تقرير
    // SAAS_PRICING_AND_BILLING_RESEARCH.html) — عمدًا مختلف عن قاعدة
    // users/{uid} اللي بتسمح لصاحب الحساب بالكتابة على مستنده هو.
    function isValidEntitlement(data) {
      return
        ('type' in data) && data.type in ['plan', 'lifetime', 'complimentary'] &&
        (!('planId' in data) || data.planId == null || data.planId in ['starter', 'professional', 'business']) &&
        (!('source' in data) || isShortStr(data.source)) &&
        (!('notes' in data)  || isLongStr(data.notes));
    }

    // تجربة مجانية 14 يوم تلقائية عند التسجيل (src/contexts/AuthContext.jsx
    // → register() → billingService.startTrial) — شكل صارم جدًا ومقفول
    // بالكامل: باقة "احترافي" بس، تاريخ انتهاء بين 13 و15 يوم من وقت
    // السيرفر (مش قيمة تعسفية من الجهاز)، ومفيش أي حقل أدمن. العميل
    // يقدر ينشئ المستند ده مرة واحدة بس طول عمر حسابه — create مبدئيًا
    // بينجح لو المستند مش موجود، ولو نجح مرة هيفضل موجود، وأي محاولة
    // تانية (تعديل أو حذف وإعادة إنشاء) هترفض لأن update/delete فاضلين
    // أدمن بس تحت. يعني مفيش أي طريقة العميل يمدّ تجربته أو يكررها بنفسه.
    function isValidTrialSelfCreate(uid, data) {
      return
        isOwner(uid) &&
        data.type == 'plan' &&
        data.source == 'trial' &&
        data.planId == 'professional' &&
        data.startDate is timestamp &&
        data.startDate > request.time - duration.value(1, 'h') &&
        data.startDate < request.time + duration.value(1, 'h') &&
        data.expirationDate is timestamp &&
        data.expirationDate > request.time + duration.value(13, 'd') &&
        data.expirationDate < request.time + duration.value(15, 'd') &&
        (!('adminOverrideBy' in data)) &&
        (!('adminOverrideAt' in data)) &&
        (!('notes' in data) || data.notes == '');
    }

    match /entitlements/{uid} {
      allow get:    if isSignedIn() && (isOwner(uid) || isAdmin());
      allow list:   if isSignedIn() && isAdmin();
      allow create: if (isAdmin() && isValidEntitlement(request.resource.data))
                    || isValidTrialSelfCreate(uid, request.resource.data);
      allow update: if isAdmin() && isValidEntitlement(request.resource.data);
      allow delete: if isAdmin();
    }

    function isValidSubscription(data) {
      return
        (!('planId' in data)          || data.planId in ['starter', 'professional', 'business']) &&
        (!('billingCycle' in data)    || data.billingCycle in ['monthly', 'annual']) &&
        (!('status' in data)          || data.status in ['trialing', 'active', 'canceled']) &&
        (!('gatewayProvider' in data) || isShortStr(data.gatewayProvider));
    }

    match /subscriptions/{uid} {
      allow get:            if isSignedIn() && (isOwner(uid) || isAdmin());
      allow list:            if isSignedIn() && isAdmin();
      allow create, update: if isAdmin() && isValidSubscription(request.resource.data);
      allow delete:          if isAdmin();
    }

    // طلبات الدفع اليدوي (فودافون كاش/InstaPay) — العميل بيعمل create
    // لطلبه بعد ما يحوّل ويبعت الإيصال عبر واتساب (نفس فكرة errorLogs
    // بالظبط: write-only بالنسبة له وقت الإنشاء، وبعدين get بس على نفس
    // الطلب اللي عمله عشان يتابع حالته). الأدمن بس اللي بيراجع كل
    // الطلبات ويحدّث حالتها بعد التأكد من التحويل يدويًا.
    function isValidBillingRequest(data) {
      return
        ('uid' in data)          && data.uid == request.auth.uid &&
        ('planId' in data)       && data.planId in ['starter', 'professional', 'business'] &&
        ('billingCycle' in data) && data.billingCycle in ['monthly', 'annual'] &&
        ('amount' in data)       && isMoney(data.amount) &&
        ('method' in data)       && data.method in ['vodafone_cash', 'instapay'] &&
        ('status' in data)       && data.status == 'pending_review';
    }

    match /billingRequests/{id} {
      allow create:          if isSignedIn() && isValidBillingRequest(request.resource.data);
      allow get:              if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list:              if isSignedIn() && isAdmin();
      allow update, delete:   if isAdmin();
    }
  }
}
