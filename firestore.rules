rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn()  { return request.auth != null; }
    function isOwner(uid)  { return request.auth.uid == uid; }
    function ownsDoc()     { return resource.data.userId == request.auth.uid; }
    function hasUserId()   { return request.resource.data.keys().hasAll(['userId']); }
    // بتمنع إن أي update يغيّر حقل userId نفسه — من غيرها، صاحب مستند شرعي
    // يقدر "ينقل" مستنده لحساب شركة تانية بمجرد ما يعدّل الحقل ده، وده مش
    // IDOR بالمعنى الكلاسيكي (مفيش حد بيقرا بيانات مش بتاعته) لكنه بيسمح
    // بحقن مستند غريب جوه بيانات شركة تانية من غير علمها.
    function keepsOwner()  { return request.resource.data.userId == resource.data.userId; }

    // أدمن التطبيق — لازم تحط نفس الـ UID هنا وفي src/config/constants.js
    // (ADMIN_UIDS). ده اللي بيسمح فعلياً بقراءة قائمة كل المستخدمين — مش
    // مجرد إخفاء زرار في الواجهة، ده الحماية الحقيقية.
    function isAdmin() {
      return isSignedIn() && request.auth.uid in [
       "VOS2uWwCxJUsmTgT4aSBqvoxPwa2"
      ];
    }

    match /equipment/{id} {
      allow read:   if isSignedIn() && ownsDoc();
      allow create: if isSignedIn() && hasUserId() && isOwner(request.resource.data.userId);
      allow update: if isSignedIn() && ownsDoc() && keepsOwner();
      allow delete: if isSignedIn() && ownsDoc();
    }
    match /jobs/{id} {
      allow read:   if isSignedIn() && ownsDoc();
      allow create: if isSignedIn() && hasUserId() && isOwner(request.resource.data.userId);
      allow update: if isSignedIn() && ownsDoc() && keepsOwner();
      allow delete: if isSignedIn() && ownsDoc();
    }
    match /drivers/{id} {
      allow read:   if isSignedIn() && ownsDoc();
      allow create: if isSignedIn() && hasUserId() && isOwner(request.resource.data.userId);
      allow update: if isSignedIn() && ownsDoc() && keepsOwner();
      allow delete: if isSignedIn() && ownsDoc();
    }
    match /maintenance/{id} {
      allow read:   if isSignedIn() && ownsDoc();
      allow create: if isSignedIn() && hasUserId() && isOwner(request.resource.data.userId);
      allow update: if isSignedIn() && ownsDoc() && keepsOwner();
      allow delete: if isSignedIn() && ownsDoc();
    }
    match /payments/{id} {
      allow read:   if isSignedIn() && ownsDoc();
      allow create: if isSignedIn() && hasUserId() && isOwner(request.resource.data.userId);
      allow update: if isSignedIn() && ownsDoc() && keepsOwner();
      allow delete: if isSignedIn() && ownsDoc();
    }
    match /driverCosts/{id} {
      allow read:   if isSignedIn() && ownsDoc();
      allow create: if isSignedIn() && hasUserId() && isOwner(request.resource.data.userId);
      allow update: if isSignedIn() && ownsDoc() && keepsOwner();
      allow delete: if isSignedIn() && ownsDoc();
    }
    match /salaryEntries/{id} {
      allow read:   if isSignedIn() && ownsDoc();
      allow create: if isSignedIn() && hasUserId() && isOwner(request.resource.data.userId);
      allow update: if isSignedIn() && ownsDoc() && keepsOwner();
      allow delete: if isSignedIn() && ownsDoc();
    }
    match /attendance/{id} {
      allow read:   if isSignedIn() && ownsDoc();
      allow create: if isSignedIn() && hasUserId() && isOwner(request.resource.data.userId);
      allow update: if isSignedIn() && ownsDoc() && keepsOwner();
      allow delete: if isSignedIn() && ownsDoc();
    }
    match /custodyTransactions/{id} {
      allow read:   if isSignedIn() && ownsDoc();
      allow create: if isSignedIn() && hasUserId() && isOwner(request.resource.data.userId);
      allow update: if isSignedIn() && ownsDoc() && keepsOwner();
      allow delete: if isSignedIn() && ownsDoc();
    }
    match /settings/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // ملف بروفايل بسيط لكل مستخدم (اسم، إيميل، تاريخ تسجيل، آخر نشاط).
    // بيتحدث تلقائياً من AuthContext. القراءة الفردية لصاحب الحساب بس،
    // لكن الأدمن يقدر يقرا كل الحسابات (list) عشان صفحة /admin.
    match /users/{userId} {
      allow get:            if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list:            if isSignedIn() && isAdmin();
      allow create, update: if isSignedIn() && isOwner(userId);
      allow delete:          if false;
    }

    // Automatic + manual data backups. Doc id under /backups is the userId
    // itself (metadata: lastBackupAt), snapshots live in a subcollection.
    // الأدمن يقدر يقرا الـ metadata بس (تاريخ آخر باك أب) عشان شاشة متابعة
    // الشركات — مش محتوى النسخ نفسه، ده لسه مقفول على صاحبه بس (isOwner).
    match /backups/{userId} {
      allow read:  if isSignedIn() && (isOwner(userId) || isAdmin());
      allow write: if isSignedIn() && isOwner(userId);

      match /snapshots/{snapshotId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
    }

    // سجل أخطاء التطبيق — أي مستخدم مسجّل دخول يقدر يكتب خطأ حصل عنده
    // (write-only بالنسبة له، مش بيقرا القائمة أبداً)، والأدمن بس اللي
    // يقدر يقرا/يعدّل (يعلّم كـ "متحلّة")/يمسح. isOwner على create زي باقي
    // الـ collections، بيمنع مستخدم إنه يزوّر خطأ باسم مستخدم تاني.
    match /errorLogs/{id} {
      allow create: if isSignedIn() && hasUserId() && isOwner(request.resource.data.userId);
      allow read, update, delete: if isAdmin();
    }

    // تنبيهات بيبعتها الأدمن للمستخدمين — إما لكل الشركات (targetUserId
    // == null) أو لشركة واحدة بعينها (targetUserId == uid بتاعها).
    // القراءة مسموحة للمستخدم لو الرسالة موجهالكل الناس أو موجهاله هو
    // بالتحديد — الشرط ده بيتأكد منه Firestore نفسه لكل مستند على حدة،
    // مش بس بيثق في فلتر الكويري اللي الفرونت باعته.
    match /adminMessages/{id} {
      allow read: if isSignedIn() &&
        (resource.data.targetUserId == null ||
         resource.data.targetUserId == request.auth.uid ||
         isAdmin());
      allow create, update, delete: if isAdmin();
    }
  }
}
